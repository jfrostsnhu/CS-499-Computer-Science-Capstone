@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Inventory Manager v2</a>
    </div>
</div>
<input type="checkbox" title="Navigation menu" class="navbar-toggler" />
<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <AuthorizeView Roles="Admin, User">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/Manage/Inventory">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Inventory
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="nav-item px-3">
                    <a class="nav-link d-flex justify-content-between align-items-center" data-bs-toggle="collapse" href="#adminMenu" role="button" aria-expanded="false" aria-controls="adminMenu">
                        <span>
                            <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Administration
                        </span>
                    </a>
                    <div class="collapse" id="adminMenu">
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="/Manage/Roles">
                                <span class="bi bi-lock-nav-menu" aria-hidden="true"></span> Roles
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="/Manage/Users">
                                <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Users
                            </NavLink>
                        </div>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/About">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> About
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
@inherits LayoutComponentBase
@layout InventoryManagerApp.Components.Layout.MainLayout
@inject NavigationManager NavigationManager

<!-- This page ensures an HttpContext for SignalR connectivity  -->

@if (HttpContext is null)
{
    <p>Loading...</p>
}
else
{
    @Body
}

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnParametersSet()
    {
        if (HttpContext is null)
        {
            // If HttpContext is null authentication cannot function, reload.
            NavigationManager.Refresh(forceReload: true);
        }
    }
}

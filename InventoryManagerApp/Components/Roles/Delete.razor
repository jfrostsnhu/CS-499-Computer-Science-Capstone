@page "/Manage/Roles/delete"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using InventoryManagerApp.Data
@using InventoryManagerApp.Components.Account
@inject RoleManager<IdentityRole> RoleManager
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles="Admin")]

<PageTitle>Delete Role</PageTitle>

<!-- This page is used to delete items -->

<h1>Delete Role</h1>
<br />
<p>Are you sure you want to delete this role?</p>
<div>
    <hr />
    @if (Role is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Role Name</dt>
            <dd class="col-sm-10">@Role.Name</dd>
        </dl>
        <EditForm method="post" Model="Role" OnValidSubmit="DeleteRole" FormName="deleteRole" Enhance>
            <a class="btn btn-secondary" href="/Manage/Roles/">Back</a>
            <button type="submit" class="btn btn-purple">Delete</button>
        </EditForm>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    private string? Id { get; set; }

    private IdentityRole? Role { get; set; }
    private string? ErrorMessage { get; set; }

    // Gets the role by Id on render
    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Id))
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }

        Role = await RoleManager.FindByIdAsync(Id);

        if (Role == null)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }
    }

    // Deletes the role
    private async Task DeleteRole()
    {
        // Ensure not null
        if (Role == null)
        {
            ErrorMessage = "Role not found";
            StateHasChanged();
            return;
        }

        // Delete the role from the database
        var result = await RoleManager.DeleteAsync(Role);
        if (result.Succeeded)
        {
            // If successful return to Manage Roles screen
            NavigationManager.NavigateTo("/Manage/Roles/");
        }
        else
        {
            // Otherwise throw an error message
            ErrorMessage = string.Join(",", result.Errors.Select(e => e.Description));
            StateHasChanged();
        }
    }
}

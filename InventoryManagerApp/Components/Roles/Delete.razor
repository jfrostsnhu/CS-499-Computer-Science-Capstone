@page "/Manage/Roles/delete"

@using Microsoft.EntityFrameworkCore
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using InventoryManagerApp.Data
@using InventoryManagerApp.Components.Account

@inject RoleManager<IdentityRole> RoleManager
@inject NavigationManager NavigationManager

<PageTitle>Delete Role</PageTitle>

<h1>Delete Role</h1>

<p>Are you sure you want to delete this role?</p>
<div>
    <hr />
    @if (Role is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Role Name</dt>
            <dd class="col-sm-10">@Role.Name</dd>
        </dl>
        <EditForm method="post" Model="Role" OnValidSubmit="DeleteRole" FormName="deleteRole" Enhance>
            <a class="btn btn-secondary" href="/Manage/Roles/">Back</a>
            <button type="submit" class="btn btn-danger">Delete</button>
        </EditForm>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    private string? Id { get; set; }

    private IdentityRole? Role { get; set; }
    private string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Id))
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }

        Role = await RoleManager.FindByIdAsync(Id);

        if (Role == null)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }
    }

    private async Task DeleteRole()
    {
        if (Role == null)
        {
            ErrorMessage = "Role not found";
            StateHasChanged();
            return;
        }

        var result = await RoleManager.DeleteAsync(Role);

        if (result.Succeeded)
        {
            NavigationManager.NavigateTo("/Manage/Roles/");
        }
        else
        {
            ErrorMessage = string.Join(",", result.Errors.Select(e => e.Description));
            StateHasChanged();
        }
    }
}

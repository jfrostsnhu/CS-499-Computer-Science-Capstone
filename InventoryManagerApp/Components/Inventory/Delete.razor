@page "/Manage/Inventory/delete"

@using Microsoft.EntityFrameworkCore
@using InventoryManagerApp.Data

@inject IDbContextFactory<InventoryManagerApp.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete Item</PageTitle>

<h1>Delete Item</h1>

<p>Are you sure you want to delete this item?</p>
<div>
    <hr />
    @if (item is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">SKU</dt>
            <dd class="col-sm-10">@item.SKU</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">UPC</dt>
            <dd class="col-sm-10">@item.UPC</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@item.Description</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Vendor</dt>
            <dd class="col-sm-10">@item.Vendor</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Cost</dt>
            <dd class="col-sm-10">@item.Cost</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Price</dt>
            <dd class="col-sm-10">@item.Price</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Quantity</dt>
            <dd class="col-sm-10">@item.Quantity</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Last Updated</dt>
            <dd class="col-sm-10">@item.LastUpdated</dd>
        </dl>
        <EditForm method="post" Model="item" OnValidSubmit="DeleteItem" FormName="deleteItem" Enhance>
            <a class="btn btn-secondary" href="/Manage/Inventory/">Back</a>
            <button type="submit" class="btn btn-danger" disabled="@(item is null)">Delete</button>
        </EditForm>
    }
</div>

@code {
    private Item? item;

    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        item = await context.Item.FirstOrDefaultAsync(m => m.Id == Id);

        if (item is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteItem()
    {
        using var context = DbFactory.CreateDbContext();
        context.Item.Remove(item!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/Manage/Inventory");
    }
}

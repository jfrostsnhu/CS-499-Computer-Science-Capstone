@page "/Manage/Users/delete"

@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using InventoryManagerApp.Data
@using InventoryManagerApp.Components.Account
@using InventoryManagerApp.Components.Account.Shared

@inject ILogger<Delete> Logger
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager

<PageTitle>Delete User</PageTitle>

<h1>Delete User</h1>

<p>Are you sure you want to delete this user?</p>
<div>
    <hr />
    @if (user is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">User Name</dt>
            <dd class="col-sm-10">@user.UserName</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Email</dt>
            <dd class="col-sm-10">@user.Email</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">First Name</dt>
            <dd class="col-sm-10">@user.FirstName</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Last Name</dt>
            <dd class="col-sm-10">@user.LastName</dd>
        </dl>
        <EditForm method="post" Model="@user" OnValidSubmit="DeleteUser" FormName="deleteUser" Enhance>
            <a class="btn btn-secondary" href="/Manage/Users/">Back</a>
            <button type="submit" class="btn btn-danger" disabled="@(user is null)">Delete</button>
        </EditForm>
    }
</div>

@code {
    private ApplicationUser? user;

    [SupplyParameterFromQuery]
    private string? Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        user = await UserManager.FindByIdAsync(Id);

        if (user is null)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }
    }

    private async Task DeleteUser()
    {
        var result = await UserManager.DeleteAsync(user);

        if (!result.Succeeded)
        {
            Logger.LogInformation("Error deleting user");
            NavigationManager.NavigateTo("/Manage/Users");
            return;
        }

        Logger.LogInformation("Deleted user successfully.");
        NavigationManager.NavigateTo("/Manage/Users");
    }
}
